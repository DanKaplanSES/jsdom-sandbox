{
  "name": "jsdom-sandbox",
  "version": "0.0.1",
  "description": "A simple sandbox for playing around with jsdom.",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "test": "jasmine --config=\"spec/support/jasmine-spec.json\"",
    "exec": "npm run compile-typescript && node dist/index.js",
    "compile-typescript": "tsc --build --verbose",
    "lint": "eslint '**/*.(js|ts)' --fix"
  },
  "devDependencies": {
    "@types/jasmine": "^5.1.1",
    "@types/jquery": "^3.5.25",
    "@types/jsdom": "^21.1.4",
    "eslint": "^8.52.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-no-floating-promise": "^1.0.2",
    "eslint-plugin-prettier": "^5.0.0",
    "@typescript-eslint/eslint-plugin": "6.17.0",
    "@typescript-eslint/parser": "6.17.0",
    "jasmine": "^5.1.0",
    "typescript": "5.3.3",
    "prettier": "^3.2.5"
  },
  "dependencies": {
    "@prettier/sync": "^0.3.0",
    "@types/winston": "^2.4.4",
    "jquery": "^3.7.1",
    "jsdom": "^24.0.0",
    "prettier": "^3.0.3",
    "ts-node": "10.9.2",
    "tslib": "2.6.2",
    "typescript": "5.3.3",
    "winston": "^3.13.0"
  }
}
